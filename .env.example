# --- App ---
APP_NAME=AI Email-to-Action Automation System
ENV=development            # development | production
DEMO_MODE=true              # true = use mock Gmail + mock AI (no real credentials needed)

# --- Database ---
# For local/demo use SQLite (no setup needed):
DATABASE_URL=sqlite:///./app.db
# For PostgreSQL, use something like:
# DATABASE_URL=postgresql://user:password@localhost:5432/email_automation

# --- Gmail API (only required when DEMO_MODE=false) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
GMAIL_TOKEN_FILE=token.json

# --- AI Analysis (Anthropic Claude) ---
# Only required when DEMO_MODE=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Workflow rules ---
CONFIDENCE_THRESHOLD=0.75
